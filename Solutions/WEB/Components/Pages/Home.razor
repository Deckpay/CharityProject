@page "/"
@inject NavigationManager Navigation
@rendermode InteractiveServer

@* 1. SZEKCIÓ: HERO *@
<section id="home" class="bg-slate-900">
    <div class="hero-container">
        
        <div class="hero-content-wrapper">
            <span class="sub-title">Közvetlen segítség, tárgyak útján</span>
            <h1>Ami Önnek felesleg, az másnak kincs</h1>
            <p>
                Adja oda megunt, de jó állapotú tárgyait azoknak, akiknek valóban szükségük van rá.
                Egyszerű feltöltés, megyei bontás, közvetlen kapcsolat.
            </p>

            <div class="cta-grid">
                <div class="cta-box give">
                    <span class="material-symbols-outlined">upload_file</span>
                    <h3>Adni szeretnék</h3>
                    <img class="images"  src="/Images/adok.png" />
                    <p>Töltse fel a tárgyat, válasszon megyét és kategóriát.</p>
                    <button @onclick='() => Navigation.NavigateTo("/my-products")'>Hirdetés feladása</button>
                </div>

                <div class="cta-box receive">
                    <span class="material-symbols-outlined">inventory_2</span>
                    <h3>Keresek valamit</h3>
                    <img class=" images" src="/Images/keresekvalamit.png" />
                    <p>Böngésszen az igényelhető termékek között megyék szerint.</p>
                    <button class="btn-alt" @onclick='() => Navigation.NavigateTo("/products")'>Termékek böngészése</button>
                </div>
            </div>
        </div>
    </div>
</section>

@* 2. SZEKCIÓ: RÓLUNK *@
<section id="rolunk">
    <div class="content-container split-layout">
        <div class="text-side">
            <span class="sub-title">Küldetésünk</span>
            <h2>Miért jöttünk létre?</h2>
            <p>
                Nap mint nap látjuk, mennyi felesleges, de jó állapotú tárgy halmozódik fel a háztartásokban, miközben másoknak pont ezekre lenne szükségük.
            </p>
            <p>
                A <strong>Értékmentő oldal</strong> célja, hogy áthidalja a távolságot az adományozók és a rászorulók között. Nem kérünk pénzt, nem bonyolítjuk túl: csak összekötjük az embereket.
            </p>
            <ul class="feature-list">
                <li><span class="material-symbols-outlined">check_circle</span> Környezettudatos újrahasznosítás</li>
                <li><span class="material-symbols-outlined">check_circle</span> Közvetlen, gyors segítségnyújtás</li>
                <li><span class="material-symbols-outlined">check_circle</span> Ellenőrzött közösség</li>
            </ul>
        </div>
        <div class="image-side">            
                <img class="recycle-img" src="/Images/kuldetesunk.png" />
        </div>
    </div>
</section>

@* 3. SZEKCIÓ: EREDMÉNYEK *@
<section id="eredmenyek">
    <div class="content-container centered-layout">
        <span class="sub-title">Amiért dolgozunk</span>
        <h2>Eddigi hatásunk számokban</h2>
        <p class="section-desc">Közösségünk ereje abban rejlik, hogy minden apró felajánlás valaki másnak a világot jelentheti.*</p>

        <div class="stats-grid">
            <div class="stat-card given-items">
                <span class="material-symbols-outlined">package_2</span>
                <span class="number">1,250+</span>
                <span class="label">Átadott tárgy</span>
            </div>
            <div class="stat-card given-help">
                <span class="material-symbols-outlined">group</span>
                <span class="number">850</span>
                <span class="label">Segített család</span>
            </div>
            <div class="stat-card saved-material">
                <span class="material-symbols-outlined">forest</span>
                <span class="number">3.5t</span>
                <span class="label">Megmentett hulladék</span>
            </div>
            <div class="stat-card supporterts">
                <span class="material-symbols-outlined">location_on</span>
                <span class="number">19</span>
                <span class="label">Aktív megye</span>
            </div>
        </div>
    </div>
</section>

@* 4. SZEKCIÓ: GYIK *@
<section id="gyik">
    <div class="content-container">
        <h2>Gyakran Ismételt Kérdések</h2>
        <div class="accordion">
            <details class="elso_kerdes">
                <summary>Hogyan tudok hirdetést feladni?</summary>                
                <p>A "Hirdetés feladása" gombra kattintva, egy gyors regisztráció után feltöltheted a tárgy fotóját és leírását. A hirdetés azonnal megjelenik a rendszerben.</p>
            </details>
            <details class="masodik_kerdes">
                <summary>Ingyenes a szolgáltatás?</summary>                
                <p>Igen! Az oldal használata mind az adományozók, mind a keresők számára teljesen ingyenes. Célunk a segítségnyújtás.</p>
            </details>
            <details class="harmadik_kerdes">
                <summary>Hogyan jut el a tárgy a rászorulóhoz?</summary>
                <p>Az alkalmazás csak összeköti a feleket. Az átvétel módját (személyes találkozó vagy postázás) a felek egymás között beszélik meg a chaten.</p>
            </details>
            <details class="negyedik_kerdes">
                <summary>Milyen tárgyakat lehet feltölteni?</summary>                
                <p>Bármit, ami működőképes, tiszta és biztonságos. Bútorok, ruhák, elektronikai eszközök, játékok és könyvek a leggyakoribb kategóriák.</p>
            </details>
        </div>
    </div>
</section>

@* 5. SZEKCIÓ: KAPCSOLAT *@
<section id="kapcsolat">
    <div class="content-container split-layout contact-layout">
        <div class="contact-info">
            <h2>Lépj velünk kapcsolatba</h2>
            <p>Kérdésed van? Ötleted támadt? Vagy csak megosztanál egy sikertörténetet? Írj nekünk bátran!</p>

            <div class="info-item">
                <span class="material-symbols-outlined">mail</span>
                <div>
                    <strong>Email címünk</strong>
                    <a href="mailto:info@charityapp.hu">info@charityapp.hu</a>
                </div>
            </div>
            <div class="info-item">
                <span class="material-symbols-outlined">call</span>
                <div>
                    <strong>Telefonszámunk</strong>
                    <a href="tel:+3612345678">+36 1 234 5678</a>
                </div>
            </div>
            <div class="info-item">
                <span class="material-symbols-outlined">pin_drop</span>
                <div>
                    <strong>Központ</strong>
                    <span>1055 Budapest, Példa utca 12.</span>
                </div>
            </div>
        </div>
    </div>
</section>
<footer class="bottom-bar">
    <div class="content-container">
        <div class="footer-flex">
            <p>&copy; @DateTime.Now.Year Értékmentő. Minden jog fenntartva.</p>
            <p>*A statisztika eredményei csak tájékoztató jellegűek, nem a valoságot mutatják.</p>
        </div>
    </div>
</footer>
