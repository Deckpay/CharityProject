@using Microsoft.AspNetCore.Components.Authorization
@using WEB.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject LocalStorageService Storage
@rendermode InteractiveServer

<nav class="sidebar @(isOpened ? "sidebar-opened" : "sidebar-closed")">

    @* Logo *@
    <a class="sidebar-logo" href="/">
        <div class="logo-icon">
            <span class="material-symbols-outlined">volunteer_activism</span>
        </div>
        @if (isOpened)
        {
            <span class="logo-text">Charity App</span>
        }
    </a>

    @* Toggle *@
    <button class="toggle-btn" @onclick="ToggleSidebar">
        <span class="material-symbols-outlined @(isOpened ? "ti-open" : "ti-closed")">chevron_left</span>
    </button>

    @* Nav *@
    <div class="nav-scroll">
        <AuthorizeView Context="auth">
            <Authorized>
                <AuthorizeView Roles="Admin" Context="adminAuth">
                    <Authorized>
                        @if (isOpened)
                        {
                            <span class="section-label">Adminisztráció</span>
                        }
                        <a class="nav-item @Active("/admin-users")" href="/admin-users">
                            <span class="material-symbols-outlined">groups</span>
                            @if (isOpened)
                            {
                                <span>Felhasználók</span>
                            }
                        </a>
                        <a class="nav-item @Active("/admin-products")" href="/admin-products">
                            <span class="material-symbols-outlined">inventory</span>
                            @if (isOpened)
                            {
                                <span>Termékek</span>
                            }
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        @if (isOpened)
                        {
                            <span class="section-label">Navigáció</span>
                        }
                        <a class="nav-item" href="/#home"><span class="material-symbols-outlined">home</span>@if(isOpened){
                        <span>Főoldal</span>
                                                }
</a>
                        <a class="nav-item" href="/#rolunk"><span class="material-symbols-outlined">info</span>@if(isOpened){
                        <span>Rólunk</span>
                                                }
</a>
                        <a class="nav-item" href="/#eredmenyek"><span class="material-symbols-outlined">leaderboard</span>@if(isOpened){
                        <span>Eredmények</span>
                                                }
</a>
                        <a class="nav-item" href="/#gyik"><span class="material-symbols-outlined">help_outline</span>@if(isOpened){
                        <span>GYIK</span>
                                                }
</a>
                        <a class="nav-item" href="/#kapcsolat"><span class="material-symbols-outlined">contact_page</span>@if(isOpened){
                        <span>Kapcsolat</span>
                                                }
</a>

                        <AuthorizeView Roles="Recipient" Context="recAuth">
                            <Authorized>
                                <div class="nav-divider"></div>
                                @if (isOpened)
                                {
                                    <span class="section-label">Termékek</span>
                                }
                                <a class="nav-item @Active("/products")" href="/products"><span class="material-symbols-outlined">storefront</span>@if(isOpened){
                                <span>Böngészés</span>
                                                                }
</a>
                                <a class="nav-item @Active("/my-requests")" href="/my-requests"><span class="material-symbols-outlined">assignment_turned_in</span>@if(isOpened){
                                <span>Igényléseim</span>
                                                                }
</a>
                                <a class="nav-item @Active("/chats")" href="/chats"><span class="material-symbols-outlined">forum</span>@if(isOpened){
                                <span>Chatek</span>
                                                                }
</a>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Donor" Context="donAuth">
                            <Authorized>
                                <div class="nav-divider"></div>
                                @if (isOpened)
                                {
                                    <span class="section-label">Adományozás</span>
                                }
                                <a class="nav-item @Active("/my-products")" href="/my-products"><span class="material-symbols-outlined">inventory_2</span>@if(isOpened){
                                <span>Termékeim</span>
                                                                }
</a>
                                <a class="nav-item @Active("/product-create")" href="/product-create"><span class="material-symbols-outlined">add_circle</span>@if(isOpened){
                                <span>Új hirdetés</span>
                                                                }
</a>
                            </Authorized>
                        </AuthorizeView>
                    </NotAuthorized>
                </AuthorizeView>
            </Authorized>

            <NotAuthorized>
                @if (isOpened)
                {
                    <span class="section-label">Navigáció</span>
                }
                <a class="nav-item" href="/#home"><span class="material-symbols-outlined">home</span>@if(isOpened){
                <span>Főoldal</span>
                                }
</a>
                <a class="nav-item" href="/#rolunk"><span class="material-symbols-outlined">info</span>@if(isOpened){
                <span>Rólunk</span>
                                }
</a>
                <a class="nav-item" href="/#eredmenyek"><span class="material-symbols-outlined">leaderboard</span>@if(isOpened){
                <span>Eredmények</span>
                                }
</a>
                <a class="nav-item" href="/#gyik"><span class="material-symbols-outlined">help_outline</span>@if(isOpened){
                <span>GYIK</span>
                                }
</a>
                <a class="nav-item" href="/#kapcsolat"><span class="material-symbols-outlined">contact_page</span>@if(isOpened){
                <span>Kapcsolat</span>
                                }
</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    @* Bottom *@
    <div class="sidebar-bottom">
        <AuthorizeView>
            <Authorized>
                <div class="user-card">
                    <div class="user-avatar">
                        @{
                            var uname = context.User.Identity?.Name ?? "?";
                        }
                        <span>@(uname.Length > 0 ? uname[0].ToString().ToUpper() : "?")</span>
                    </div>
                    @if (isOpened)
                    {
                        <div class="user-info">
                            <span class="user-name">@uname</span>
                            <span class="user-role">@(context.User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Felhasználó")</span>
                        </div>
                    }
                </div>
                <button @onclick="HandleLogout" class="logout-btn">
                    <span class="material-symbols-outlined">logout</span>
                    @if (isOpened)
                    {
                        <span>Kijelentkezés</span>
                    }
                </button>
            </Authorized>
            <NotAuthorized>
                <button @onclick="GoToLogin" class="auth-action login-btn">
                    <span class="material-symbols-outlined">login</span>
                    @if (isOpened)
                    {
                        <span>Bejelentkezés</span>
                    }
                </button>
                <button @onclick="GoToRegister" class="auth-action register-btn">
                    <span class="material-symbols-outlined">person_add</span>
                    @if (isOpened)
                    {
                        <span>Regisztráció</span>
                    }
                </button>
            </NotAuthorized>
        </AuthorizeView>
    </div>

</nav>

@code {
    private bool isOpened = true;
    private void ToggleSidebar() => isOpened = !isOpened;
    private void GoToLogin() => Navigation.NavigateTo("/login");
    private void GoToRegister() => Navigation.NavigateTo("/register");
    private string Active(string path) =>
        Navigation.Uri.Contains(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    private async Task HandleLogout()
    {
        var provider = (CustomAuthStateProvider)AuthProvider;
        await provider.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
