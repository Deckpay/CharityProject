@using Microsoft.AspNetCore.Components.Authorization
@using WEB.Components.Shared
@using WEB.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject LocalStorageService Storage
@inject ChatApiService ChatService
@inject ToastService ToastService
@rendermode InteractiveServer
@implements IDisposable

<nav class="sidebar @(isOpened ? "sidebar-opened" : "sidebar-closed") mobile-sidebar-fix">

    @* Nyitó/Záró gomb *@
    <button class="toggle-btn mobile-hide-toggle" @onclick="ToggleSidebar">
        <span class="material-symbols-outlined rotate-icon @(isOpened ? "" : "is-mirror")">
            chevron_left
        </span>
    </button>

    @* Nav *@
    <div class="nav-scroll">
        <AuthorizeView Context="auth">
            <Authorized>
                <AuthorizeView Roles="Admin" Context="adminAuth">
                    <Authorized>
                        @if (isOpened)
                        {
                            <span class="section-label">Adminisztráció</span>
                        }
                        <a class="nav-item @Active("/admin-users")" href="/admin-users" @onclick="HandleNavLinkClick">
                            <span class="material-symbols-outlined">groups</span>
                            @if (isOpened)
                            {
                                <span>Felhasználók</span>
                            }
                        </a>
                        <a class="nav-item @Active("/admin-products")" href="/admin-products" @onclick="HandleNavLinkClick">
                            <span class="material-symbols-outlined">inventory</span>
                            @if (isOpened)
                            {
                                <span>Termékek</span>
                            }
                        </a>
                        <a class="nav-item @Active("/admin-product-requests")" href="/admin-product-requests" @onclick="HandleNavLinkClick">
                            <span class="material-symbols-outlined">inventory</span>
                            @if (isOpened)
                            {
                                <span>Igénylések</span>
                            }
                        </a>
                        <a class="nav-item @Active("/admin-product-requester-limits")" href="/admin-product-requester-limits" @onclick="HandleNavLinkClick">
                            <span class="material-symbols-outlined">inventory</span>
                            @if (isOpened)
                            {
                                <span>Limitek</span>
                            }
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        @if (isOpened)
                        {
                            <span class="section-label">Navigáció</span>
                        }
                        <a class="nav-item" href="/#home" @onclick="HandleNavLinkClick">
                            <span class="material-symbols-outlined">home</span>
                            @if (isOpened)
                            {
                                <span>Főoldal</span>
                            }
                        </a>
                        <a class="nav-item" href="/#rolunk" @onclick="HandleNavLinkClick">
                            <span class="material-symbols-outlined">info</span>
                            @if (isOpened)
                            {
                                <span>Rólunk</span>
                            }
                        </a>
                        <a class="nav-item" href="/#eredmenyek" @onclick="HandleNavLinkClick">
                            <span class="material-symbols-outlined">leaderboard</span>
                            @if (isOpened)
                            {
                                <span>Eredmények</span>
                            }
                        </a>
                        <a class="nav-item" href="/#gyik" @onclick="HandleNavLinkClick">
                            <span class="material-symbols-outlined">help_outline</span>
                            @if (isOpened)
                            {
                                <span>GYIK</span>
                            }
                        </a>
                        <a class="nav-item" href="/#kapcsolat" @onclick="HandleNavLinkClick">
                            <span class="material-symbols-outlined">contact_page</span>
                            @if (isOpened)
                            {
                                <span>Kapcsolat</span>
                            }
                        </a>

                        <AuthorizeView Roles="Requester" Context="recAuth">
                            <Authorized>
                                <div class="nav-divider"></div>
                                @if (isOpened)
                                {
                                    <span class="section-label">Termékek</span>
                                }
                                <a class="nav-item @Active("/products")" href="/products" @onclick="HandleNavLinkClick">
                                    <span class="material-symbols-outlined">storefront</span>
                                    @if (isOpened)
                                    {
                                        <span>Böngészés</span>
                                    }
                                </a>
                                <a class="nav-item @Active("/my-requests")" href="/my-requests" @onclick="HandleNavLinkClick">
                                    <span class="material-symbols-outlined">assignment_turned_in</span>
                                    @if (isOpened)
                                    {
                                        <span>Igényléseim</span>
                                    }
                                </a>
                                <a class="nav-item @Active("/chats")" href="/chats" @onclick="HandleNavLinkClick">
                                    <span class="material-symbols-outlined">forum</span>
                                    @if (isOpened)
                                    {
                                        <span>Chatek</span>
                                    }
                                    @if (unreadCount > 0)
                                    {
                                        <span class="nav-badge">@(unreadCount > 9 ? "9+" : unreadCount.ToString())</span>
                                    }
                                </a>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Sender" Context="donAuth">
                            <Authorized>
                                <div class="nav-divider"></div>
                                @if (isOpened)
                                {
                                    <span class="section-label">Adományozás</span>
                                }
                                <a class="nav-item @Active("/my-products")" href="/my-products" @onclick="HandleNavLinkClick">
                                    <span class="material-symbols-outlined">inventory_2</span>
                                    @if (isOpened)
                                    {
                                        <span>Termékeim</span>
                                    }
                                </a>
                                <a class="nav-item @Active("/chats")" href="/chats" @onclick="HandleNavLinkClick">
                                    <span class="material-symbols-outlined">forum</span>
                                    @if (isOpened)
                                    {
                                        <span>Chatek</span>
                                    }
                                    @if (unreadCount > 0)
                                    {
                                        <span class="nav-badge">@(unreadCount > 9 ? "9+" : unreadCount.ToString())</span>
                                    }
                                </a>
                            </Authorized>
                        </AuthorizeView>
                    </NotAuthorized>
                </AuthorizeView>
            </Authorized>

            <NotAuthorized>
                @if (isOpened)
                {
                    <span class="section-label">Navigáció</span>
                }
                <a class="nav-item" href="/#home" @onclick="HandleNavLinkClick">
                    <span class="material-symbols-outlined">home</span>
                    @if (isOpened)
                    {
                        <span>Főoldal</span>
                    }
                </a>
                <a class="nav-item" href="/#rolunk" @onclick="HandleNavLinkClick">
                    <span class="material-symbols-outlined">info</span>
                    @if (isOpened)
                    {
                        <span>Rólunk</span>
                    }
                </a>
                <a class="nav-item" href="/#eredmenyek" @onclick="HandleNavLinkClick">
                    <span class="material-symbols-outlined">leaderboard</span>
                    @if (isOpened)
                    {
                        <span>Eredmények</span>
                    }
                </a>
                <a class="nav-item" href="/#gyik" @onclick="HandleNavLinkClick">
                    <span class="material-symbols-outlined">help_outline</span>
                    @if (isOpened)
                    {
                        <span>GYIK</span>
                    }
                </a>
                <a class="nav-item" href="/#kapcsolat" @onclick="HandleNavLinkClick">
                    <span class="material-symbols-outlined">contact_page</span>
                    @if (isOpened)
                    {
                        <span>Kapcsolat</span>
                    }
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    @* Bottom *@
    <div class="sidebar-bottom">
        <AuthorizeView>
            <Authorized>
                <button type="button" class="profile-open-btn" @onclick="OpenProfileModal">
                    <div class="user-card">
                        <div class="user-avatar">
                            @{
                                var firstName = context.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "";
                                var lastName = context.User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value ?? "";
                                var fullName = $"{firstName} {lastName}".Trim();
                            }
                            <span>
                                @(fullName.Length > 0
                                    ? fullName.Split(' ').First()[0].ToString().ToUpper()
                                    : "?")
                            </span>
                        </div>
                        @if (isOpened)
                        {
                            <div class="user-info">
                                <span class="user-name">@fullName</span>
                            </div>
                        }
                    </div>
                </button>
                <button @onclick="HandleLogout" class="logout-btn">
                    <span class="material-symbols-outlined">logout</span>
                    @if (isOpened)
                    {
                        <span>Kijelentkezés</span>
                    }
                </button>
            </Authorized>
            <NotAuthorized>
                <button @onclick='async () => { await HandleNavLinkClick(); GoToLogin(); }' class="auth-action login-btn">
                    <span class="material-symbols-outlined">login</span>
                    @if (isOpened)
                    {
                        <span>Bejelentkezés</span>
                    }
                </button>
                <button @onclick='async () => { await HandleNavLinkClick(); GoToRegister(); }' class="auth-action register-btn">
                    <span class="material-symbols-outlined">person_add</span>
                    @if (isOpened)
                    {
                        <span>Regisztráció</span>
                    }
                </button>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<ProfilModal IsOpen="@showProfileModal" OnClose="CloseProfileModal" />

@code {
    private bool isOpened = true;
    private int unreadCount = 0;
    private PeriodicTimer? _timer;
    private bool showProfileModal = false;
    [Parameter] public EventCallback OnNavigate { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var provider = (CustomAuthStateProvider)AuthProvider;
        var isValid = await provider.ValidateTokenAsync();

        if (!isValid)
        {
            ToastService.ShowToast("A munkamenet lejárt. Kérlek jelentkezz be újra.", "error");
            Navigation.NavigateTo("/login");
            return;
        }

        Navigation.LocationChanged += OnLocationChanged;

        var token = await Storage.GetItemAsync<string>("authToken") ?? "";

        if (!string.IsNullOrEmpty(token))
        {
            unreadCount = await ChatService.GetUnreadCountAsync(token);
            StateHasChanged();
            _ = StartPollingAsync(token);
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var token = await Storage.GetItemAsync<string>("authToken") ?? "";
                if (!string.IsNullOrEmpty(token))
                {
                    unreadCount = await ChatService.GetUnreadCountAsync(token);
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
                throw;
            }
        });
    }

    private async Task StartPollingAsync(string token)
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        while (await _timer.WaitForNextTickAsync())
        {
            unreadCount = await ChatService.GetUnreadCountAsync(token);
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _timer?.Dispose();
    }

    private void ToggleSidebar() => isOpened = !isOpened;

    private void GoToLogin() => Navigation.NavigateTo("/login");

    private void GoToRegister() => Navigation.NavigateTo("/register");

    private string Active(string path) =>
        Navigation.Uri.Contains(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    private async Task HandleLogout()
    {
        _timer?.Dispose();
        var provider = (CustomAuthStateProvider)AuthProvider;
        await provider.LogoutAsync();
        await HandleNavLinkClick();
        ToastService.ShowToast("Sikeres kijelentkezés!", "success");
        Navigation.NavigateTo("/");
    }

    private async Task HandleNavLinkClick() => await OnNavigate.InvokeAsync();

    private void OpenProfileModal()
    {
        showProfileModal = true;
    }

    private Task CloseProfileModal()
    {
        showProfileModal = false;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
