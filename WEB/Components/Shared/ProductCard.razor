@using Application.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using WEB.Services
@using Domain.Enums
@inject IConfiguration Configuration
@inject ProductRequestApiService ProductRequestService
@inject ProductApiService ProductApiService
@inject NavigationManager Navigation
@inject LocalStorageService LocalStorage
@inject ToastService ToastService

<div class="modern-product-card @(isClaimed ? "card-claimed" : "")">
    <div class="card-header-section">
        <div class="status-badge">@GetStatusName(Product.ProductStatus.ToString())</div>

        <div class="image-container">
            @if (!string.IsNullOrEmpty(Product.ImagePath))
            {
                <img src="@imageUrl" alt="@Product.ProductName" class="main-product-img @(isClaimed ? "img-dimmed" : "")" />
            }
            else
            {
                <div class="no-image-placeholder">Nincs kép</div>
            }
        </div>
    </div>

    <div class="card-content-section">
        <div class="content-left">
            <h3 class="product-name-title">@Product.ProductName</h3>
            <div class="product-details-link" @onclick="() => OnDetails.InvokeAsync(Product)">
                Részletek →
            </div>
        </div>

        <div class="content-right">
            <div class="info-item">
                <span class="info-label">KATEGÓRIA</span>
                <span class="info-value">@CategoryName</span>
            </div>
            <div class="info-item">
                <span class="info-label">HELYSZÍN</span>
                <span class="info-value">@CountyName</span>
            </div>
        </div>
    </div>

    <div class="card-action-footer">
        <AuthorizeView Roles="Recipient">
            <Authorized>
                @if (claimError)
                {
                    <span class="error-text">❌ Hiba történt</span>
                }
                else if (isMyActiveClaim)
                {
                    @* Ez a user már igényelte – elhalványult gomb + chat link *@
                    <button class="claim-action-btn btn-claimed" disabled="disabled">
                        ⏳ Igénylés alatt
                    </button>
                    <a href="/chat/@activeRequestId" class="chat-link-small">Chat megnyitása →</a>
                }
                else if (isClaimedByOther)
                {
                    @* Más user már igényelte – nem elérhető *@
                    <button class="claim-action-btn btn-claimed" disabled="disabled">
                        🔒 Már igényelve
                    </button>
                }
                else
                {
                    <button class="claim-action-btn" @onclick="ClaimProduct"
                            disabled="@(isClaiming ? "disabled" : null)">
                        @(isClaiming ? "FOLYAMATBAN..." : "IGÉNYLÉS")
                    </button>
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Donor">
            <Authorized>
                @if (claimError)
                {
                    <span class="error-text">❌ Hiba történt</span>
                }
                else
                {
                    <div class="d-flex justify-content-between mt-2">
                        
                        <button class="btn btn-primary flex-fill me-2"
                            disabled="@(Product.ProductStatus != ProductStatus.Active)"
                            @onclick="() => {
                                if (Product.ProductStatus == ProductStatus.Active)
                                    OnEdit.InvokeAsync(Product);
                            }">
                            Szerkesztés
                        </button>

                        <button class="btn btn-danger flex-fill"
                            disabled="@(Product.ProductStatus != ProductStatus.Active)"
                            @onclick="async () => {
                                if (Product.ProductStatus == ProductStatus.Active)
                                    await HandleDelete(Product.ProductId);
                            }">
                            Törlés
                        </button>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Parameter] public ProductDto Product { get; set; } = new();
    [Parameter] public string CategoryName { get; set; } = "Egyéb";
    [Parameter] public string CountyName { get; set; } = "Ismeretlen";
    [Parameter] public EventCallback<ProductDto> OnDetails { get; set; }
    [Parameter] public EventCallback<ProductDto> OnEdit { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    private bool isClaiming = false;
    private bool claimError = false;
    private bool isMyActiveClaim = false;    // ennek a usernek van aktív igénylése
    private bool isClaimedByOther = false;   // más usernek van aktív igénylése
    private bool isClaimed => isMyActiveClaim || isClaimedByOther;
    private int activeRequestId = 0;
    private string imageUrl = "";

    protected override void OnParametersSet()
    {
        var apiBase = Configuration["ApiSettings:BaseUrl"] ?? "";
        var staticBase = apiBase.Replace("/api/", "").Replace("/api", "").TrimEnd('/');
        var path = Product.ImagePath ?? "";
        if (!path.StartsWith("/")) path = "/" + path;
        imageUrl = staticBase + path;
    }

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken") ?? "";
        if (string.IsNullOrEmpty(token)) return;

        // Lekérdezzük: van-e ennek a usernek aktív igénylése erre a termékre
        activeRequestId = await ProductRequestService.GetActiveRequestIdForProductAsync(Product.ProductId, token);
        isMyActiveClaim = activeRequestId > 0;

        // Ha a usernek nincs saját igénylése, megnézzük, hogy más igényelte-e már
        // Ezt onnan tudjuk meg, hogy a ClaimProductAsync 0-t ad vissza foglalt terméknél
        // Egy külön endpoint-ot használunk: is-claimed
        if (!isMyActiveClaim)
        {
            isClaimedByOther = await ProductRequestService.IsProductClaimedAsync(Product.ProductId, token);
        }
    }

    private async Task ClaimProduct()
    {
        isClaiming = true;
        claimError = false;
        try
        {
            var rawToken = await LocalStorage.GetItemAsync<string>("authToken") ?? "";
            var token = rawToken.Trim('"');
            var result = await ProductRequestService.ClaimProductAsync(Product.ProductId, token);
            if (result.Success)
            {
                activeRequestId = result.RequestId ?? 0;
                isMyActiveClaim = true;
                ToastService.ShowToast("Sikeres igénylés", "success");
                StateHasChanged();
                Navigation.NavigateTo($"/chat/{activeRequestId}");
            }
            else
            {
                ToastService.ShowToast(result.Message, "error");
                isClaimedByOther = true;
                claimError = true;
                StateHasChanged();
            }
        }
        catch
        {
            claimError = true;
        }
        finally
        {
            isClaiming = false;
        }
    }

    private async Task HandleDelete(int productId)
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

        try
        {
            await ProductApiService.DeleteProductAsync(productId, token);
            ToastService.ShowToast("Termék törölve", "success");

            if (OnDelete.HasDelegate)
                await OnDelete.InvokeAsync(productId);
        }
        catch
        {
            ToastService.ShowToast("Hiba történt a törlés sorám", "error");
        }
    }

    private string GetStatusName(string? status) => status switch
    {
        "Active" => "Aktív",
        "Pending" => "Folyamatban",
        "Completed" => "Befejezett",
        "Deleted" => "Törölt",
        _ => "Ismeretlen"
    };
}
