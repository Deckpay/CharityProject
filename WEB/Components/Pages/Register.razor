@page "/register"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@using Application.DTOs
@using Application.Interfaces
@using Domain.Entities
@using WEB.Services
@using Web.Services
@inject AuthApiService AuthService
@inject NavigationManager NavigationManager
@inject LookupApiService Lookup

<PageTitle>Regisztráció</PageTitle>
<div class="register-container">
    <div class="registration-card form-control">
        <div>
            <div>
                <h3>Új fiók létrehozása</h3>

                <EditForm Model="@registerModel" OnValidSubmit="HandleRegistration" FormName="RegistrationForm">
                    <DataAnnotationsValidator />

                    <div class="">
                        <label>Felhasználónév</label>
                        
                        <InputText  @bind-Value="registerModel.UserName" class="form-control " placeholder="Kérlek add meg a felhasználó neved"  />
                        <ValidationMessage For="@(() => registerModel.UserName)" />
                    </div>

                    <div>
                        <div>
                            <label>Vezetéknév</label>
                            
                            <InputText @bind-Value="registerModel.LastName" class="form-control" placeholder="Kérlek add meg a vezetékneved" />
                        </div>
                        <div>
                            <label>Keresztnév</label>
                            
                            <InputText @bind-Value="registerModel.FirstName" class="form-control" placeholder="Kérlek add meg a kereszt  neved" />
                        </div>
                    </div>

                    <div>
                        <label>Email cím</label>
                        
                        <InputText @bind-Value="registerModel.Email" class="form-control" placeholder="Kérlek add meg az email cíned"  />
                        <ValidationMessage For="@(() => registerModel.Email)" />
                    </div>

                    <div class="selectForm">
                        <label>Megye</label>
                        <InputSelect @bind-Value="registerModel.CountyId" class="form-control">
                            <option value="0">-- Válassz megyét --</option>
                            @foreach (var county in counties)
                            {
                                <option value="@county.CountyId">@county.CountyName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => registerModel.CountyId)" />
                    </div>

                    <div>
                        <label>Jelszó</label>
                        <div class="password-wrapper">

                            <InputText @bind-Value="registerModel.Password" type="@(showPassword ? "text" : "password")" class="form-control" placeholder="Kérlek add meg a jelszavad minimum 6 karakter" />
                                <button type="button" class="password-icon" @onclick="TogglePassword" tabindex="-1">
                                 <i class="bi @(showPassword ? "bi-eye" : "bi-eye-slash")"></i>
                                </button>
                            
                        </div>
                            <ValidationMessage For="@(() => registerModel.Password)" />

                        
                    </div>

                    <div>
                        <label>Jelszó újra</label>
                        <div class="password-wrapper">

                        <InputText @bind-Value="registerModel.ConfirmPassword" type="@(showPassword? "text": "password")" class="form-control" placeholder="Kérlek add meg a jelszavad újból" />
                        <button type="button" class="auth-btn btn-outline-secondary password-icon" @onclick="TogglePassword">
                            <i class="bi @(showPassword ? "bi-eye" : "bi-eye-slash")"></i>                              
                        </button>
                        </div>
                        <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <div>
                        <label>Regisztráció célja</label>
                        <InputSelect @bind-Value="registerModel.RoleId" class="form-control">
                            <option value="0">-- Válassz szerepkört --</option>
                            <option value="1">Adományozó (Donor)</option>s
                            <option value="2">Rászoruló (Recipient)</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => registerModel.RoleId)" />
                    </div>
                    <div class="actions">

                        <button type="submit" class="actions">Regisztráció</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterDto registerModel = new();
    private IEnumerable<County> counties = new List<County>();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Betöltjük a megyéket az adatbázisból a lenyíló listához
        counties = await Lookup.GetCountiesAsync();
    }

    private async Task HandleRegistration()
    {
        var result = await AuthService.RegisterAsync(registerModel);

        if (result)
        {
            // Sikeres regisztráció után átirányítás (pl. a bejelentkezéshez)
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            errorMessage = "A regisztráció nem sikerült. Lehet, hogy már létezik ilyen felhasználó.";
        }
    }

    /*jelszó rejtése vagy megjelanítési állapota*/
    private bool showPassword = false;

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }
}
