@page "/product-create"
@using Application.DTOs
@using Application.Interfaces
@using Application.Services
@using Domain.Entities
@using Infrastructure.Services
@using Microsoft.AspNetCore.Authorization
@using WEB.Services
@inject NavigationManager Navigation
@inject AuthApiService AuthService
@inject ProductApiService productService
@inject CustomAuthStateProvider AuthStateProvider
@inject LookupApiService Lookup
@inject LocalStorageService LocalStorage
@rendermode InteractiveServer

<div class="create-product-bg">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="product-card">
                <div class="product-card-header text-center">
                    <h3><i class="bi bi-plus-circle me-2"></i>Új termék hirdetése</h3>
                    <p class="text-muted">Töltsd ki az adatokat a termék felvételéhez</p>
                </div>

                <div class="product-card-body">
                    <EditForm Model="@productDto" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        @if (showSuccessMessage)
                        {
                            <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <div><strong>Siker!</strong> A termék hirdetése sikeresen feladva.</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <div>@errorMessage</div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold">Termék Neve</label>
                            <InputText @bind-Value="productDto.ProductName" class="form-control custom-input" placeholder="Pl.: Mosógép" />
                            <ValidationMessage For="@(() => productDto.ProductName)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Leírás</label>
                            <InputTextArea @bind-Value="productDto.ProductDescription" class="form-control custom-input" rows="3" placeholder="Írd le a termék részleteit..." />
                            <ValidationMessage For="@(() => productDto.ProductDescription)" class="text-danger small" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Kategória</label>
                                <InputSelect @bind-Value="productDto.ProductCategoryId" class="form-select custom-input">
                                    <option value="0" disabled selected>-- Válassz --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.ProductCategoryId">@cat.ProductCategoryName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => productDto.ProductCategoryId)" class="text-danger small" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Megye</label>
                                <InputSelect @bind-Value="productDto.CountyId" class="form-select custom-input">
                                    <option value="0" disabled selected>-- Válassz --</option>
                                    @foreach (var county in counties)
                                    {
                                        <option value="@county.CountyId">@county.CountyName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => productDto.CountyId)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Kép feltöltése</label>
                            <div class="file-upload-wrapper">
                                <InputFile OnChange="OnFileSelected" class="form-control" id="fileInput" />
                                @if (!string.IsNullOrEmpty(selectedFileName))
                                {
                                    <div class="selected-file-name mt-2 small text-primary">
                                        <i class="bi bi-image me-1"></i> Kiválasztva: @selectedFileName
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="row g-3 mt-4">
                            @* MÉGSE GOMB *@
                            <div class="col-sm-6 text-start">
                                <button type="button" 
                                        class="btn btn-cancel w-100 py-2" 
                                        @onclick="Cancel" 
                                        disabled="@isSubmitting">
                                    <i class="bi bi-x-circle me-1"></i> Mégse
                                </button>
                            </div>

                            @* BEKÜLDÉS GOMB *@
                            <div class="col-sm-6 text-end">
                                <button type="submit" 
                                        class="btn btn-primary-custom w-100 py-2" 
                                        disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Mentés...</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-check2-circle me-1"></i> Termék beküldése</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ProductDto productDto = new();
    private string? errorMessage;
    private bool isSubmitting = false;
    private bool showSuccessMessage = false; // Új változó a siker jelzésére
    private string? selectedFileName;

    // Csak egyszer deklaráljuk a listákat.
    // Használjuk az Entity típusokat, ha a Service azt ad vissza.
    private List<ProductCategory> categories = new();
    private List<County> counties = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Várjuk meg, hogy a CustomAuthStateProvider beolvassa a tokent.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            // Ha nincs bejelentkezett Donor felhasználó, navigáljunk a bejelentkező oldalra (klien oldali ellenőrzés).
            if (authState.User?.Identity == null || !authState.User.Identity.IsAuthenticated || !authState.User.IsInRole("Donor"))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            try
            {
                // Adatok lekérése
                var catResult = await Lookup.GetProductCategoriesAsync();
                categories = catResult.ToList();

                var countyResult = await Lookup.GetCountiesAsync();
                counties = countyResult.ToList();
            }
            catch (Exception ex)
            {
                errorMessage = "Nem sikerült betölteni az alapadatokat: " + ex.Message;
            }

            StateHasChanged();
        }
    }

    IBrowserFile? imageFile;

    void OnFileSelected(InputFileChangeEventArgs e)
    {
        imageFile = e.File;
        selectedFileName = imageFile?.Name;
    }


    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            if (imageFile == null)
            {
                errorMessage = "Kép kiválasztása kötelező!";
                return;
            }

            // Itt küldjük be a DTO-t
            var token = await LocalStorage.GetItemAsync<string>("authToken") ?? "";
            var success = await productService.CreateProductAsync(productDto, imageFile!, token);
            if (success)
            {
                showSuccessMessage = true;
                productDto = new(); // reset
                selectedFileName = null;
                await Task.Delay(1500); // Várunk 5 másodpercet
                Navigation.NavigateTo("/my-products"); // Vagy a sikeres oldaladra
                // StateHasChanged(); // Frissítjük a felületet
                // StateHasChanged(); // Eltüntetjük az üzenetet
            }
            else
            {
                errorMessage = "A mentés nem sikerült a szerveren.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Hiba a mentés során: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
    
    private async void Cancel()
    {
        // Adatok törlése/alaphelyzetbe állítása
        productDto = new ProductDto(); 
        imageFile = null;
        selectedFileName = null;
        errorMessage = null;
        showSuccessMessage = false;

        // Ha maradsz az oldalon, értesítjük a Blazort a változásról
        StateHasChanged();

        await Task.Delay(1500); // Várunk 5 másodpercet
        // Visszanavigálunk a termékek listájára (vagy bárhova máshová)
        Navigation.NavigateTo("/my-products"); 
    }
}
