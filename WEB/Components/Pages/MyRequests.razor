@page "/my-requests"
@using Application.DTOs
@using Domain.Entities
@using WEB.Services
@inject NavigationManager Navigation
@inject ProductApiService ProductService
@inject CustomAuthStateProvider AuthStateProvider
@inject LocalStorageService LocalStorage

<div class="container mt-4">
    <h3 class="mb-4">Igényléseim</h3>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Betöltés...</span>
            </div>
            <p class="ms-3">Igénylések betöltése...</p>
        </div>
    }
    else if (!requests.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted">Még nincs igénylésed.</p>
            <a href="/products" class="btn btn-primary mt-2">Termékek böngészése</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var req in requests)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@GetProductName(req.ProductId)</h5>
                            <p class="text-muted small mb-1">
                                Igényelve: @req.RequestedAt.ToLocalTime().ToString("yyyy. MM. dd. HH:mm")
                            </p>
                            <p class="mb-3">
                                <span class="badge @GetStatusBadgeClass(req.RequestStatus)">
                                    @GetStatusText(req.RequestStatus)
                                </span>
                            </p>
                            <div class="mt-auto">
                                <a href="/chat/@req.ProductRequestId" class="btn btn-outline-primary w-100">
                                    💬 Chat megnyitása
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ProductRequestDto> requests = new();
    private List<ProductDto> products = new();
    private bool isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User?.Identity == null || !authState.User.Identity.IsAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            try
            {
                var token = await LocalStorage.GetItemAsync<string>("authToken") ?? "";
                requests = (await ProductService.GetMyRequestsAsync(token)).ToList();
                products = (await ProductService.GetProductsAsync()).ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Hiba: {ex.Message}");
            }

            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetProductName(int productId) =>
        products.FirstOrDefault(p => p.ProductId == productId)?.ProductName ?? $"Termék #{productId}";

    private string GetStatusText(int status) => status switch
    {
        0 => "Függőben",
        1 => "Elfogadva",
        2 => "Elutasítva",
        _ => "Ismeretlen"
    };

    private string GetStatusBadgeClass(int status) => status switch
    {
        0 => "bg-warning text-dark",
        1 => "bg-success",
        2 => "bg-danger",
        _ => "bg-secondary"
    };
}
