@page "/my-requests"
@using Application.DTOs
@using Domain.Entities
@using Domain.Enums
@using WEB.Services
@inject NavigationManager Navigation
@inject ProductApiService ProductService
@inject ProductRequestApiService ProductRequestService
@inject CustomAuthStateProvider AuthStateProvider
@inject LocalStorageService LocalStorage
@inject ToastService ToastService
@implements IDisposable

<div class="requests-page">
    <div class="page-header">
        <h2>Igényléseim</h2>
        @if (!isLoading)
        {
            <span class="badge-count">@requests.Count aktív</span>
        }
    </div>

    @if (isLoading)
    {
        <div class="skeleton-grid">
            @for (int i = 0; i < 6; i++)
            {
                <div class="skeleton-card">
                    <div class="sk-line" style="width:55%;height:18px;"></div>
                    <div class="sk-line" style="width:35%;height:12px;margin-top:8px;"></div>
                    <div class="sk-line" style="width:25%;height:20px;margin-top:10px;border-radius:10px;"></div>
                    <div class="sk-line" style="width:100%;height:36px;margin-top:16px;border-radius:8px;"></div>
                </div>
            }
        </div>
    }
    else if (!requests.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <h3>Még nincs igénylésed</h3>
            <p>Böngéssz a termékek között és igényelj egyet!</p>
            <a href="/products" class="btn-browse">Termékek böngészése</a>
        </div>
    }
    else
    {
        <div class="requests-grid">
            @foreach (var req in requests)
            {
                <div class="request-card">
                    <div class="card-top-row">
                        <span class="status-badge @req.RequestStatus">
                            Állapot: @GetStatusText(req.RequestStatus)
                        </span>
                        <button class="delete-icon-btn" @onclick="() => AskDelete(req.ProductRequestId)"
                                title="Törlés">
                            <span class="material-symbols-outlined">delete_outline</span>
                        </button>
                    </div>
                    <div class="card-product-name">
                        @(req.ProductName ?? $"Termék #{req.ProductId}")
                    </div>
                    <div class="card-date">
                        <span class="material-symbols-outlined">schedule</span>
                        @req.RequestedAt.ToLocalTime().ToString("yyyy. MM. dd. HH:mm")
                    </div>
                    <a href="/chat/@req.ProductRequestId" class="btn-chat">
                        <span class="material-symbols-outlined">chat</span>
                        Chat megnyitása
                    </a>
                </div>
            }
        </div>
    }
</div>

@if (showConfirm)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="modal-card" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="CancelDelete">
                <span class="material-symbols-outlined">close</span>
            </button>
            <div class="modal-danger-icon">
                <span class="material-symbols-outlined">delete_forever</span>
            </div>
            <h3 class="modal-title">Töröljük az igénylést?</h3>
            <p class="modal-desc">Ez a művelet nem vonható vissza.<br />A chat üzenetek is törlődnek.</p>
            <div class="modal-actions">
                <button class="btn-modal-cancel" @onclick="CancelDelete">Mégsem</button>
                <button class="btn-modal-danger" @onclick="ConfirmDelete" @attributes="GetDeleteBtnAttrs()">
                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Igen, törlöm
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductRequestDto> requests = new();
    private List<ProductDto> products = new();
    private bool isLoading = true;
    private bool showConfirm = false;
    private bool isDeleting = false;
    private int? deletingId = null;
    private string token = "";
    private PeriodicTimer? _timer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User?.Identity == null || !authState.User.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        token = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

        try
        {
            requests = (await ProductRequestService.GetMyRequestsAsync(token)).ToList();
            products = (await ProductService.GetProductsAsync()).ToList();
        }
        catch (Exception ex) { Console.WriteLine($"Hiba: {ex.Message}"); }

        isLoading = false;
        StateHasChanged();

        _ = StartPollingAsync();
    }

    private async Task StartPollingAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        while (await _timer.WaitForNextTickAsync())
        {
            try
            {
                requests = (await ProductRequestService.GetMyRequestsAsync(token)).ToList();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Polling hiba: {ex.Message}");
            }
        }
    }

    private void AskDelete(int id) { deletingId = id; showConfirm = true; }
    private void CancelDelete() { showConfirm = false; deletingId = null; }

    private async Task ConfirmDelete()
    {
        if (deletingId == null) return;
        isDeleting = true;
        try
        {
            await ProductRequestService.DeleteRequestAsync(deletingId.Value, token);
            requests.RemoveAll(r => r.ProductRequestId == deletingId.Value);
        }
        catch (Exception ex) { Console.WriteLine($"Törlési hiba: {ex.Message}"); }
        finally 
        { 
            isDeleting = false; 
            showConfirm = false; 
            deletingId = null;
            ToastService.ShowToast("Sikeresen törölted az igénylést", "success");
            StateHasChanged(); 
        }
    }

    private Dictionary<string, object> GetDeleteBtnAttrs() =>
        isDeleting ? new Dictionary<string, object> { { "disabled", "disabled" } }
                   : new Dictionary<string, object>();

    private string GetStatusText(RequestStatus status)
    {
        return status switch
        {
            RequestStatus.Pending => "Függőben",
            RequestStatus.Completed => "Sikeres",
            RequestStatus.Failed => "Sikertelen",
            _ => status.ToString()
        };
    }

    public void Dispose() => _timer?.Dispose();
}
