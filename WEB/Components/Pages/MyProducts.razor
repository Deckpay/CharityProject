@page "/my-products"
@using Application.DTOs
@using Application.Interfaces
@using Application.Services
@using Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using WEB.Components.Shared
@using WEB.Services
@inject NavigationManager Navigation
@inject AuthApiService AuthService
@inject ProductApiService productService
@inject CustomAuthStateProvider AuthStateProvider
@inject LookupApiService Lookup
@inject LocalStorageService LocalStorage

<div class="page-background-fix">
    <div class="container py-5">
        <div class="row">
            <div class="col-12">

                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <h2 class="page-title">Termékek böngészése</h2>
                    <button class="btn btn-add-product" @onclick='() => Navigation.NavigateTo("/product-create")'>
                        <i class="bi bi-plus-lg"></i> Termék feladása
                    </button>
                </div>

                <!-- SZŰRŐ -->
                <div class="filter-card shadow mb-5">
                    <div class="row g-3 align-items-end">

                        <div class="col-xl-4 col-lg-12">
                            <label class="filter-label">Keresés</label>
                            <div class="custom-input-group">
                                <span class="group-icon"><i class="bi bi-search"></i></span>
                                <input type="text"
                                       class="clean-input"
                                       @bind="searchQuery"
                                       @bind:event="oninput"
                                       @onkeyup="ResetPagination"
                                       placeholder="Név vagy leírás..." />
                            </div>
                        </div>

                        <div class="col-xl-4 col-md-6">
                            <label class="filter-label">Kategória</label>
                            <div class="custom-input-group">
                                <select class="clean-input"
                                        @bind="selectedCategoryId"
                                        >
                                    <option value="0">Összes kategória</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.ProductCategoryId">@cat.ProductCategoryName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-xl-4 col-md-6">
                            <label class="filter-label">Megye</label>
                            <div class="custom-input-group">
                                <select class="clean-input"
                                        @bind="selectedCountyId"
                                        >
                                    <option value="0">Összes megye</option>
                                    @foreach (var county in counties)
                                    {
                                        <option value="@county.CountyId">@county.CountyName</option>
                                    }
                                </select>
                            </div>
                        </div>

                    </div>
                </div>

                @if (isLoading)
                {
                    <div class="d-flex justify-content-center my-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Betöltés...</span>
                        </div>
                        <p class="ms-3">Termékek betöltése...</p>
                    </div>
                }

                <!-- EDIT MODAL -->
                @if (showEditModal && editingProduct != null)
                {
                    <div class="modal-backdrop">
                        <div class="modal-content p-4">

                            <h4>Szerkesztés</h4>

                            <input class="form-control mb-2" @bind="editingProduct.ProductName" />
                            <input class="form-control mb-2" @bind="editingProduct.ProductDescription" />

                            <select class="form-control mb-2" @bind="editingProduct.ProductCategoryId">
                                @foreach (var c in categories)
                                {
                                    <option value="@c.ProductCategoryId">@c.ProductCategoryName</option>
                                }
                            </select>

                            <select class="form-control mb-2" @bind="editingProduct.CountyId">
                                @foreach (var c in counties)
                                {
                                    <option value="@c.CountyId">@c.CountyName</option>
                                }
                            </select>

                            <button class="btn btn-success me-2" @onclick="SaveProduct">Mentés</button>
                            <button class="btn btn-secondary" @onclick="CloseModal">Bezárás</button>

                        </div>
                    </div>
                }

                <!-- DETAIL MODAL -->
                <ProductDetailModal @ref="productModal" />

                <!-- TERMÉKEK -->
                <div class="product-grid">
                    @if (PaginatedProducts.Any())
                    {
                        @foreach (var product in PaginatedProducts)
                        {
                            <ProductCard Product="product"
                                         CategoryName="@GetCategoryName(product.ProductCategoryId)"
                                         CountyName="@GetCountyName(product.CountyId)"
                                         OnDetails="ShowProductDetails"
                                         OnEdit="OpenEditModal" />
                        }
                    }
                </div>

                <!-- LAPOZÁS -->
                @if (TotalPages > 1)
                {
                    <div class="pagination-wrapper mt-5">
                        <button class="pag-btn" @onclick="PrevPage" disabled="@(currentPage == 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        <div class="page-numbers">
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var p = i;
                                <button class="page-num @(currentPage == p ? "active" : "")"
                                        @onclick="() => ChangePage(p)">
                                    @p
                                </button>
                            }
                        </div>

                        <button class="pag-btn" @onclick="NextPage" disabled="@(currentPage == TotalPages)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {
    private List<ProductDto> allProducts = new();
    private List<ProductCategory> categories = new();
    private List<County> counties = new();

    private string searchQuery = "";
    private int selectedCategoryId = 0;
    private int selectedCountyId = 0;
    private bool isLoading = true;
    private string token = "";

    private ProductDto? editingProduct;
    private bool showEditModal = false;

    private int currentPage = 1;
    private int pageSize = 20; // 30 elem / oldal

    private IEnumerable<ProductDto> PaginatedProducts =>
        FilteredProducts
        .OrderByDescending(p => p.CreatedAt)
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private int TotalPages =>
        (int)Math.Ceiling((double)FilteredProducts.Count() / pageSize);

    private void ResetPagination() => currentPage = 1;

    private void NextPage()
    {
        if (currentPage < TotalPages)
            currentPage++;
    }

    private void PrevPage()
    {
        if (currentPage > 1)
            currentPage--;
    }

    private void ChangePage(int p) => currentPage = p;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            token = await LocalStorage.GetItemAsync<string>("authToken") ?? "";
            // 1. Megvárjuk, amíg a Provider beolvassa a tokent a LocalStorage-ból
            // Ez feltölti a TokenStore-t is!
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            if (authState.User?.Identity == null || !authState.User.Identity.IsAuthenticated || !authState.User.IsInRole("Donor"))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            // 2. Csak ezután hívjuk meg az API-t
            try
            {
                allProducts = (await productService.GetMyProductsAsync(token)).ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Hiba a betöltésnél: {ex.Message}");
            }

            await LoadFilters();
            isLoading = false;
            StateHasChanged(); // Frissítjük a UI-t
        }
    }

    // -------------------------
    // EDIT MODAL
    // -------------------------
    private void OpenEditModal(ProductDto product)
    {
        editingProduct = new ProductDto
        {
            ProductId = product.ProductId,
            ProductName = product.ProductName,
            ProductDescription = product.ProductDescription,
            ProductCategoryId = product.ProductCategoryId,
            CountyId = product.CountyId,
            ProductSatus = product.ProductSatus
        };

        showEditModal = true;
    }

    private void CloseModal()
    {
        showEditModal = false;
        editingProduct = null;
    }

    private async Task SaveProduct()
    {
        if (editingProduct == null) return;

        await productService.UpdateProductAsync(editingProduct);

        var existing = allProducts.First(x => x.ProductId == editingProduct.ProductId);

        existing.ProductName = editingProduct.ProductName;
        existing.ProductDescription = editingProduct.ProductDescription;
        existing.ProductCategoryId = editingProduct.ProductCategoryId;
        existing.CountyId = editingProduct.CountyId;
        existing.ProductSatus = editingProduct.ProductSatus;

        CloseModal();
    }


    private async Task LoadProducts() => allProducts = (await productService.GetProductsAsync()).ToList();
    private async Task LoadFilters()
    {
        categories = (await Lookup.GetProductCategoriesAsync()).ToList();
        counties = (await Lookup.GetCountiesAsync()).ToList();
    }

    // A keresési logika
    private IEnumerable<ProductDto> FilteredProducts => allProducts.Where(p =>
        (string.IsNullOrWhiteSpace(searchQuery) ||
         p.ProductName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
         (p.ProductDescription?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (selectedCategoryId == 0 || p.ProductCategoryId == selectedCategoryId) &&
        (selectedCountyId == 0 || p.CountyId == selectedCountyId)
    );

    private string GetCategoryName(int id) => categories.FirstOrDefault(c => c.ProductCategoryId == id)?.ProductCategoryName ?? "Egyéb";
    private string GetCountyName(int id) => counties.FirstOrDefault(c => c.CountyId == id)?.CountyName ?? "Ismeretlen";

    private ProductDetailModal productModal;

    private void ShowProductDetails(ProductDto product)
    {
        productModal.Show(
            product,
            GetCategoryName(product.ProductCategoryId),
            GetCountyName(product.CountyId)
        );
    }
}
