@page "/chats"
@using Application.DTOs
@using Domain.Enums
@using WEB.Services
@inject NavigationManager Navigation
@inject ChatApiService ChatService
@inject ProductApiService ProductService
@inject ProductRequestApiService ProductRequestService
@inject CustomAuthStateProvider AuthStateProvider
@inject LocalStorageService LocalStorage

<div class="chats-page">
    <div class="chats-header">
        <h2>Üzenetek</h2>
        @if (!isLoading)
        {
            <span class="badge-count">@conversations.Count beszélgetés</span>
        }
    </div>

    @if (isLoading)
    {
        <div class="chats-loading">
            <div class="skeleton-row">
                <div class="skeleton-avatar"></div>
                <div class="skeleton-lines">
                    <div class="skeleton-line sl-60"></div>
                    <div class="skeleton-line sl-40"></div>
                </div>
            </div>
            <div class="skeleton-row">
                <div class="skeleton-avatar"></div>
                <div class="skeleton-lines">
                    <div class="skeleton-line sl-55"></div>
                    <div class="skeleton-line sl-35"></div>
                </div>
            </div>
            <div class="skeleton-row">
                <div class="skeleton-avatar"></div>
                <div class="skeleton-lines">
                    <div class="skeleton-line sl-65"></div>
                    <div class="skeleton-line sl-30"></div>
                </div>
            </div>
        </div>
    }
    else if (!conversations.Any())
    {
        <div class="chats-empty">
            <span>💬</span>
            <p>Még nincs aktív beszélgetésed.</p>
            <a href="/products" class="link-btn">Termékek böngészése</a>
        </div>
    }
    else
    {
        <div class="conversations-list">
            @foreach (var conv in conversations)
            {
                var chatUrl = "/chat/" + conv.RequestId.ToString();
                var reqId = conv.RequestId;
                var initial = conv.ProductName.Length > 0 ? conv.ProductName.Substring(0, 1).ToUpper() : "?";
                var preview = string.Empty;
                if (conv.LastMessage != null)
                {
                    preview = conv.LastMessage.Length > 50
                    ? conv.LastMessage.Substring(0, 50) + "…"
                    : conv.LastMessage;
                }
                var timeStr = conv.LastMessageTime.HasValue ? FormatTime(conv.LastMessageTime.Value) : string.Empty;
                var statusCls = "status-pill " + conv.Status;
                var statusTxt = conv.Status;
                var rowCls = deletingConvId == conv.RequestId ? "conv-row conv-deleting" : "conv-row";

                <div class="@rowCls" @onclick="() => Navigation.NavigateTo(chatUrl)">
                    <div class="conv-avatar">
                        <span>@initial</span>
                        @if (conv.UnreadCount > 0)
                        {
                            <span class="unread-dot">@conv.UnreadCount</span>
                        }
                    </div>
                    <div class="conv-body">
                        <div class="conv-top">
                            <span class="conv-title">@conv.ProductName</span>
                            @if (!string.IsNullOrEmpty(timeStr))
                            {
                                <span class="conv-time">@timeStr</span>
                            }
                        </div>
                        <div class="conv-preview">
                            @if (!string.IsNullOrEmpty(preview))
                            {
                                <span>@preview</span>
                            }
                            else
                            {
                                <span class="no-msg">Még nincs üzenet</span>
                            }
                        </div>
                        <div class="conv-meta">
                            <span class="@statusCls">Állapot: @GetStatusText(conv.Status)</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private class ConversationVm
    {
        public int RequestId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public RequestStatus Status { get; set; }
        public string? LastMessage { get; set; }
        public DateTime? LastMessageTime { get; set; }
        public int UnreadCount { get; set; }
    }

    private List<ConversationVm> conversations = new();
    private bool isLoading = true;
    private int? deletingConvId = null;
    private int currentUserId = 0;
    private string token = string.Empty;
    private bool isSender = false;
    private System.Threading.PeriodicTimer? _timer;
    private bool _isDisposed = false;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User?.Identity == null || !authState.User.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        isSender = authState.User.IsInRole("Sender");
        currentUserId = await AuthStateProvider.GetCurrentUserIdAsync();
        token = await LocalStorage.GetItemAsync<string>("authToken") ?? string.Empty;

        await LoadConversations();
        isLoading = false;
        StateHasChanged();

        _ = StartPolling();
    }

    private async Task StartPolling()
    {
        _timer = new System.Threading.PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await _timer.WaitForNextTickAsync() && !_isDisposed)
            {
                await LoadConversations();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadConversations()
    {
        try
        {
            var allProducts = (await ProductService.GetProductsAsync()).ToList();
            IEnumerable<ProductRequestDto> requests;

            if (isSender)
                requests = await ProductRequestService.GetSenderRequestsAsync(token);
            else
                requests = await ProductRequestService.GetMyRequestsAsync(token);

            var result = new List<ConversationVm>();
            foreach (var req in requests.OrderByDescending(r => r.RequestedAt))
            {
                var found = allProducts.FirstOrDefault(p => p.ProductId == req.ProductId);
                var productName = !string.IsNullOrEmpty(req.ProductName)
                ? req.ProductName
                : (found != null ? found.ProductName : "Termék #" + req.ProductId);

                Console.WriteLine($"RequestId: {req.ProductRequestId}, ProductId: {req.ProductId}, Found: {found?.ProductName}");
                List<ChatMessageResponseDto> msgs = new();
                try { msgs = await ChatService.GetHistoryAsync(req.ProductRequestId, token); }
                catch { }



                var last = msgs.Count > 0 ? msgs[msgs.Count - 1] : null;
                result.Add(new ConversationVm
                {
                    RequestId = req.ProductRequestId,
                    ProductName = productName,
                    Status = req.RequestStatus,
                    LastMessage = last?.Content,
                    LastMessageTime = last?.SentAt,
                    UnreadCount = msgs.Count(m => !m.IsRead && m.SenderId != currentUserId)
                });
            }
            conversations = result;
        }
        catch (Exception ex)
        {
            Console.WriteLine("Hiba: " + ex.Message);
        }
    }

    private string FormatTime(DateTime dt)
    {
        var local = dt.ToLocalTime();
        var now = DateTime.Now;
        if (local.Date == now.Date) return local.ToString("HH:mm");
        if (local.Date == now.Date.AddDays(-1)) return "Tegnap";
        return local.ToString("MM. dd.");
    }

    private string GetStatusText(RequestStatus status)
    {
        return status switch
        {
            RequestStatus.Pending => "Függőben",
            RequestStatus.Completed => "Sikeres",
            RequestStatus.Failed => "Sikertelen",
            _ => status.ToString()
        };
    }

    private string GetStatusClass(int s)
    {
        if (s == 0) return "st-pending";
        if (s == 1) return "st-accepted";
        if (s == 2) return "st-rejected";
        return string.Empty;
    }

    public void Dispose()
    {
        _isDisposed = true;
        _timer?.Dispose();
    }
}
