@page "/admin-products"
@using Application.DTOs
@using Domain.Entities
@using Domain.Enums
@using WEB.Services
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject AdminApiService AdminService
@inject LookupApiService LookupService

<div class="page-container">
    <h2>Termékek kezelése</h2>
    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Betöltés...</span>
            </div>
            <p class="ms-3">betöltés...</p>
        </div>
    }

    <div class="table-container">
        <table class="table table-hover table-striped table-bordered">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Termék Név</th>
                    <th scope="col">Termékleírás</th>
                    <th scope="col">Állapot</th>
                    <th scope="col">Feladó</th> 
                    <th scope="col">Kategória</th>
                    <th scope="col">Hely</th>
                    <th scope="col">Létrehozva</th>
                    <th scope="col">Módosítva</th>
                    <th scope="col">Műveletek</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in products)
                {
                    <tr>
                        <td>@product.ProductId</td>
                        <td>@product.ProductName</td>
                        <td>@product.ProductDescription</td>
                        <td>@product.ProductStatus</td>
                        <td>@LookupService.GetUserName(product.SenderId)</td>
                        <td>@LookupService.GetProductCategoryName(product.ProductCategoryId)</td>
                        <td>@LookupService.GetCountyName(product.CountyId)</td>
                        <td>@product.CreatedAt</td>
                        <td>@product.UpdatedAt</td>
                        <td>
                            <button class="btn btn-secondary btn-sm" @onclick="() => EditProduct(product)">Szerkesztés</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteProduct(product.ProductId)">Törlés</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (showEditModal && editingProduct != null)
    {
        <div class="modal-backdrop">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow-lg border-0">
                    <div class="modal-header text-black">
                        <h5 class="modal-title">Termékek szerkesztése</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label text-black">Termék név</label>
                            <input class="form-control" @bind="editingProduct.ProductName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-black">Termék leírás</label>
                            <input class="form-control" @bind="editingProduct.ProductDescription" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-black">Termék kategória</label>
                            <select class="form-control" @bind="editingProduct.ProductCategoryId">
                                @foreach (var category in categories)
                                {
                                    <option value="@category.ProductCategoryId">@category.ProductCategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-black">Termék helye</label>
                            <select class="form-control" @bind="editingProduct.CountyId">
                                @foreach (var county in counties)
                                {
                                    <option value="@county.CountyId">@county.CountyName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-black">Termék státusz</label>
                            <select class="form-control" @bind="editingProduct.ProductStatus">
                                @foreach (var status in Enum.GetValues<ProductStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-primary" @onclick="SaveProduct">Mentés</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProductDto> products = new();
    private List<ProductCategory> categories = new();
    private List<County> counties = new();
    private bool isLoading = true;
    private ProductDto? editingProduct;
    private bool showEditModal = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User?.Identities == null ||
            !authState.User.Identity!.IsAuthenticated ||
            !authState.User.IsInRole("Admin"))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LookupService.GetCountiesAsync();
        await LookupService.GetProductCategoriesAsync();
        await LookupService.GetUsersAsync();

        categories = (await LookupService.GetProductCategoriesAsync()).ToList();
        counties = (await LookupService.GetCountiesAsync()).ToList();
        products = (await AdminService.GetProductsAsync()).ToList();
        isLoading = false;
    }

    private void EditProduct(ProductDto productDto)
    {
        editingProduct = new ProductDto
        {
            ProductId = productDto.ProductId,
            ProductName = productDto.ProductName,
            ProductDescription = productDto.ProductDescription,
            ProductCategoryId = productDto.ProductCategoryId,
            CountyId = productDto.CountyId,
            ProductStatus = productDto.ProductStatus,
            UpdatedAt = DateTime.UtcNow
        };

        showEditModal = true;
    }

    private async Task SaveProduct()
    {
        if (editingProduct == null) return;

        await AdminService.UpdateProductAsync(editingProduct);

        showEditModal = false;

        products = (await AdminService.GetProductsAsync()).ToList();
    }

    private async Task DeleteProduct(int productId)
    {
        await AdminService.DeleteProductAsync(productId);

        products = (await AdminService.GetProductsAsync()).ToList();
    }

    private void CloseModal()
    {
        showEditModal = false;
        editingProduct = null;
    }
}
