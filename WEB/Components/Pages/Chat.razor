@page "/chat/{RequestId:int}"
@using Application.DTOs
@using WEB.Services
@inject ChatApiService ChatService
@inject ProductRequestApiService ProductRequestService
@inject CustomAuthStateProvider AuthStateProvider
@inject LocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="chat-shell">

    @* ── Fejléc ── *@
    <header class="chat-header">
        <div class="header-mainpart">
            <button class="back-btn" @onclick='() => Navigation.NavigateTo("/chats")'>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
            </button>
            <div class="header-avatar">
                <span>@(otherPartyName ?.Length > 0 ? otherPartyName[0].ToString().ToUpper() : "?")</span>
            </div>
            <div class="header-info">
                <span class="header-title">@(string.IsNullOrEmpty(otherPartyName) ? $"Igénylés #{RequestId}": otherPartyName)</span>
                <span class="header-sub">@(isLoading ? "betöltés..." : $"{messages.Count} üzenet")</span>
            </div> 
        </div>
        @if (!isChatLocked && isUserTheDonor)
        {
            <button type="button" class="btn-complete" @onclick="OpenStatusModal">
                   Átadás lezárása
            </button>
        }
    </header>

    @* ── Üzenetlista ── *@
    <main class="chat-messages" @ref="messagesEndRef">

        @if (isLoading)
        {
            <div class="loading-state">
                <div class="typing-indicator">
                    <span></span><span></span><span></span>
                </div>
            </div>
        }
        else if (!messages.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">💬</div>
                <p>Még nincs üzenet.<br />Kezdj el írni!</p>
            </div>
        }
        else
        {
            @* Üzenetek csoportosítva dátum szerint *@
            string? lastDate = null;
            foreach (var msg in messages)
            {
                if (msg.Content.StartsWith("[Rendszer]")) continue;
                bool isMe = msg.SenderId == currentUserId;
                string dateLabel = msg.SentAt.ToLocalTime().ToString("yyyy. MM. dd.");

                if (dateLabel != lastDate)
                {
                    lastDate = dateLabel;
                    <div class="date-divider"><span>@dateLabel</span></div>
                }

                @* speciális rendszerüzenet *@
                if (msg.Content.StartsWith("[RENDSZER]"))
                {
                    <div class="system-event-row" style="display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 30px 0; gap: 10px; width: 100%;">
                        <span class="badge @(msg.Content.Contains("SIKERES"))"
                              style="padding: 12px 24px; font-size: 1rem; border-radius: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                            @msg.Content.Replace("[RENDSZER]: ", "")
                        </span>
                        <span style="color: #6c757d; font-size: 0.9rem; font-weight: 500;">
                            Köszönjük a részvételt!
                        </span>
                    </div>
                    
                    continue;
                }

                <div class="msg-row @(isMe ? "row-me" : "row-other")">
                    @if (!isMe)
                    {
                        <div class="avatar-sm">@(msg.SenderName?.Length > 0 ? msg.SenderName[0].ToString().ToUpper() : "?")</div>
                    }
                    <div class="bubble-wrap">
                        @if (!isMe)
                        {
                            <span class="sender-label">@msg.SenderName</span>
                        }
                        <div class="bubble @(isMe ? "bubble-me" : "bubble-other")">
                            <span class="bubble-text">@msg.Content</span>
                            <span class="bubble-time">@msg.SentAt.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                    </div>
                </div>
            }
        }

        @* Anchor a görgetéshez *@
        <div @ref="scrollAnchor"></div>
    </main>

    @if (showStatusModal)
    {
        <div class="status-modal-container">
            <div class="status-card-v2">
                <div class="status-header">
                    <div class="status-icon">🔄</div>
                    <h3>Átadás lezárása</h3>
                    <p>Kérjük, jelöld meg a tranzakció kimenetelét!</p>
                </div>

                <div class="status-buttons-grid">
                    <button class="status-btn btn-success-modern" @onclick='() => CompleteAction("sikeres")'>
                        <span class="btn-icon">✓</span>
                        <span class="btn-text">Sikeres</span>
                    </button>

                    <button class="status-btn btn-danger-modern" @onclick='() => CompleteAction("sikertelen")'>
                        <span class="btn-icon">✕</span>
                        <span class="btn-text">Sikertelen</span>
                    </button>

                    <button class="status-btn btn-cancel-modern" @onclick="() => showStatusModal = false">
                        <span class="btn-text">Mégsem</span>
                    </button>
                </div>
            </div>
        </div>
    }

    @* Lezáró banner, ha vége az akciónak *@
    @if (isChatLocked)
    {
        <div class="lock-banner">
            
            
        </div>
    }

    @* Hibaüzenet *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-bar">
            <span>⚠ @errorMessage</span>
            <button @onclick="() => errorMessage = null">×</button>
        </div>
    }

    @* ── Beviteli sáv ── *@
    @if (!isChatLocked)
    {
        <footer class="chat-footer">
            <div class="input-row">
                <textarea class="msg-input"
                          placeholder="Írj üzenetet..."
                          rows="1"
                          @bind="newMessage"
                          @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          disabled="@(isSending ? "disabled" : null)" />
                <button class="send-btn @(CanSend ? "send-active" : "")"
                        @onclick="SendMessage"
                        disabled="@(!CanSend ? "disabled" : null)">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
                    </svg>
                </button>
            </div>
        </footer>
    }
</div>

@code {
    [Parameter] public int RequestId { get; set; }

    private List<ChatMessageResponseDto> messages = new();
    private string newMessage = string.Empty;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSending = false;
    private int currentUserId = 0;
    private string token = string.Empty;
    private ElementReference scrollAnchor;
    private ElementReference messagesEndRef;
    private PeriodicTimer? _timer;
    private bool showStatusModal = false;
    private bool isChatLocked = false;
    private string actionResult = string.Empty;
    private bool isUserTheDonor = false;
    private string otherPartyName = string.Empty;
    private bool _poolingStarted = false;
    private bool _isLOadingMessages = false;

    private bool CanSend => !isSending && !string.IsNullOrWhiteSpace(newMessage);

    private void OpenStatusModal()
    {
        showStatusModal = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User?.Identity == null || !authState.User.Identity.IsAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }



            currentUserId = await AuthStateProvider.GetCurrentUserIdAsync();
            token = await LocalStorage.GetItemAsync<string>("authToken") ?? "";

            // Párhuzamosan kérjük le a pertner nevét
            var infoTask = ChatService.GetChatINfoAsync(RequestId, token);
            var messagesTask = LoadMessages();

            await Task.WhenAll(infoTask, messagesTask);

            await CheckUserPermissions();

            var info = await infoTask;
            if (info != null)
                otherPartyName = info.OtherPartyName;

            isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
            if (!_poolingStarted)
            {
                _poolingStarted = true;
                _ = StartPollingAsync();
            }


        }
    }

    private async Task LoadMessages()
    {
        if (_isLOadingMessages) return;
        _isLOadingMessages = true;

        try
        {
            messages = await ChatService.GetHistoryAsync(RequestId, token);


            var firstMsg = messages.FirstOrDefault();
            if (firstMsg != null)
                otherPartyName = firstMsg.OtherPartyName;

            var systemMsg = messages.FirstOrDefault(m => m.Content.Contains("[RENDSZER]"));
            if (systemMsg != null)
            {
                isChatLocked = true;
                actionResult = systemMsg.Content.Contains("SIKERES") ? "SIKERES" : "SIKERTELEN";
            }

            await ChatService.MarkAsReadAllAsync(RequestId, token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chat betöltési hiba: {ex.Message}");
            errorMessage = "Nem sikerült betölteni az üzeneteket.";
        }
        finally
        {
            _isLOadingMessages = false;   
        }
    }

    private async Task CheckUserPermissions()
    {
        currentUserId = await AuthStateProvider.GetCurrentUserIdAsync();
        if (messages != null && messages.Any())
        {
            // Az üzenetben most már benne van a DonorId (az API-ból)
            var firstMsg = messages.FirstOrDefault();
            if (firstMsg != null)
            {
                isUserTheDonor = (firstMsg.DonorId == currentUserId);
                Console.WriteLine($"DEBUG: Felhasználó: {currentUserId} | Donor: {firstMsg.DonorId} | Egyezik: {isUserTheDonor}");
            }
        }
    }

    private async Task StartPollingAsync()
    {
        _timer?.Dispose();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        while (await _timer.WaitForNextTickAsync())
        {
            var freshUserId = await AuthStateProvider.GetCurrentUserIdAsync();
            if (freshUserId != currentUserId)
            {
                _timer?.Dispose();
                return;
            }
            await LoadMessages();
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
    }

    private async Task CompleteAction(string result)
    {
        var isSuccess = result == "sikeres";
        actionResult = result.ToUpper();
        showStatusModal = false;
        isChatLocked = true;

        // 1. Rendszerüzenet a chatbe
        var systemMsg = $"[RENDSZER]: Az átadás állapota: {actionResult}";
        try
        {
            await ChatService.SendMessageAsync(RequestId, systemMsg, token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Rendszerüzenet hiba: {ex.Message}");
        }

        // 2. Termék + igénylés státusz frissítése az API-n
        try
        {
            var ok = await ProductRequestService.CompleteRequestAsync(RequestId, isSuccess, token);
            if (!ok)
                errorMessage = "Figyelem: az igénylés lezárása nem sikerült teljesen.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lezárási hiba: {ex.Message}");
            errorMessage = "Nem sikerült lezárni az igénylést.";
        }

        await LoadMessages();
        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (!CanSend) return;

        var content = newMessage.Trim();
        newMessage = string.Empty;
        isSending = true;
        errorMessage = null;

        try
        {
            var success = await ChatService.SendMessageAsync(RequestId, content, token);
            if (success)
            {
                await LoadMessages();
                await ScrollToBottom();
            }
            else
            {
                errorMessage = "Nem sikerült elküldeni az üzenetet.";
                newMessage = content; // visszaírjuk, ha sikertelen
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Hálózati hiba történt.";
            newMessage = content;
            Console.WriteLine($"Küldési hiba: {ex.Message}");
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Enter küld, Shift+Enter sortörés
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("scrollToBottom", scrollAnchor);
        }
        catch { }
    }

    public void Dispose() => _timer?.Dispose();
}
